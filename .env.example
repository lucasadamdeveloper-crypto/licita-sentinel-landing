# ==============================================================================
# LICITA SENTINEL - LANDING PAGE (.env.example)
# Copie para .env.local e configure no painel da Vercel da nova conta
# ==============================================================================

# 1. BANCO DE DADOS COMPARTILHADO (Mesma DATABASE_URL do app principal)
# Exemplo Supabase / PostgreSQL:
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. URL DO APP PRINCIPAL (Onde o usuário faz login e acessa o sistema)
NEXT_PUBLIC_APP_URL="https://app.licitasentinel.com.br"

# 3. URL DESTA LANDING PAGE
NEXT_PUBLIC_SITE_URL="https://licitasentinel.com.br"

# 4. CONTATO E WHATSAPP DE SUPORTE
NEXT_PUBLIC_WHATSAPP_NUMBER="5541999999999"
